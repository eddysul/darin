SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Optional overrides; defaults are derived from SUPABASE_URL.
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

OPENAI_API_KEY=replace-with-server-secret

# Safe default: provider-backed routes remain unavailable until explicitly enabled.
DARIN_AI_ENABLED=false
DARIN_BUILD_COMMIT=unknown
DARIN_LOG_HASH_SALT=replace-with-random-server-secret
DARIN_LLM_TIMEOUT_SECONDS=20
DARIN_STT_TIMEOUT_SECONDS=45

# Comma-separated browser origins. Native clients do not require CORS.
CORS_ALLOWED_ORIGINS=
