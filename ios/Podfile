require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

# React Native 0.76's Hermes build still relies on CMake policies removed in
# CMake 4. Prefer the compatible user-level CMake installed for iOS archives.
compatible_cmake_bin = File.expand_path('~/Library/Python/3.10/bin')
if File.executable?(File.join(compatible_cmake_bin, 'cmake'))
  ENV['PATH'] = "#{compatible_cmake_bin}:#{ENV['PATH']}"
end

ENV['RCT_NEW_ARCH_ENABLED'] = podfile_properties['newArchEnabled'] == 'true' ? '1' : '0'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] = podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
# Keep Hermes enabled while building it from the React Native-pinned source tag.
# The prebuilt RN 0.76 Hermes binary does not include a matching App Store dSYM.
ENV['RCT_BUILD_HERMES_FROM_SOURCE'] = 'true'

platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'
install! 'cocoapods',
  :deterministic_uuids => false

prepare_react_native_project!

target 'Darin' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => podfile_properties['apple.ccacheEnabled'] == 'true',
    )

    # RN 0.76 invokes tar through an unquoted shell command. Use argv-based
    # execution so archives also work when the project path contains spaces.
    hermes_replace_script = File.join(
      config[:reactNativePath],
      'sdks/hermes-engine/utils/replace_hermes_version.js'
    )
    if File.exist?(hermes_replace_script)
      source = File.read(hermes_replace_script)
      source = source.sub(
        "const {execSync} = require('child_process');",
        "const {execFileSync} = require('child_process');"
      )
      source = source.sub(
        'execSync(`tar -xf ${tarballURLPath} -C ${finalLocation}`);',
        "execFileSync('tar', ['-xf', tarballURLPath, '-C', finalLocation]);"
      )
      File.write(hermes_replace_script, source)
    end

    rn_environment_script = File.join(
      config[:reactNativePath],
      'scripts/xcode/with-environment.sh'
    )
    if File.exist?(rn_environment_script)
      source = File.read(rn_environment_script)
      source = source.sub("  $1\n", "  \"$@\"\n")
      File.chmod(0755, rn_environment_script)
      File.write(rn_environment_script, source)
    end

    # Hermes builds the host compiler with a clean environment. Preserve only
    # the system tool path so CMake can locate make and Apple Clang.
    hermesc_build_script = File.join(
      config[:reactNativePath],
      'sdks/hermes-engine/utils/build-hermesc-xcode.sh'
    )
    if File.exist?(hermesc_build_script)
      source = File.read(hermesc_build_script)
      source = source.gsub(
        'env -i SDKROOT="$SDKROOT"',
        'env -i PATH="/usr/bin:/bin:/usr/sbin:/sbin" SDKROOT="$SDKROOT"'
      )
      File.chmod(0755, hermesc_build_script)
      File.write(hermesc_build_script, source)
    end

    hermes_build_script = File.join(
      config[:reactNativePath],
      'sdks/hermes-engine/utils/build-hermes-xcode.sh'
    )
    if File.exist?(hermes_build_script)
      source = File.read(hermes_build_script)
      source = source.sub("set -x\n", "set -x -e\n")
      File.chmod(0755, hermes_build_script)
      File.write(hermes_build_script, source)
    end

    # CMake's native-path conversion leaves literal backslashes in Makefile
    # arguments when the workspace path contains spaces. `cmake -E cat` keeps
    # each source path as a separately quoted argv entry.
    hermes_internal_bytecode_cmake = File.join(
      installer.sandbox.root.to_s,
      'hermes-engine/lib/InternalBytecode/CMakeLists.txt'
    )
    if File.exist?(hermes_internal_bytecode_cmake)
      source = File.read(hermes_internal_bytecode_cmake)
      source = source.gsub(
        'COMMAND ${concatenate} ${internal_bytecode_sources_native_path} > ${CMAKE_CURRENT_BINARY_DIR}/InternalBytecode.js',
        'COMMAND ${CMAKE_COMMAND} -E cat ${internal_bytecode_sources} > ${CMAKE_CURRENT_BINARY_DIR}/InternalBytecode.js'
      )
      File.chmod(0644, hermes_internal_bytecode_cmake)
      File.write(hermes_internal_bytecode_cmake, source)
    end

    # fmt 11 bundled with this React Native version hits a Clang 21 consteval
    # regression. Disable that optional path only for Apple Clang 21+.
    fmt_base_header = File.join(installer.sandbox.root.to_s, 'fmt/include/fmt/base.h')
    if File.exist?(fmt_base_header)
      source = File.read(fmt_base_header)
      source = source.sub(
        'defined(__apple_build_version__) && __apple_build_version__ < 14000029L',
        'defined(__apple_build_version__) && (__apple_build_version__ < 14000029L || __apple_build_version__ >= 21000000L)'
      )
      File.chmod(0644, fmt_base_header)
      File.write(fmt_base_header, source)
    end

    # Quote generated script paths so Xcode phases keep working when the
    # workspace directory contains spaces (for example "Childcare Management App").
    installer.pods_project.targets.each do |pod_target|
      pod_target.build_phases.each do |phase|
        next unless phase.respond_to?(:shell_script) && phase.shell_script

        phase.shell_script = phase.shell_script.gsub(
          'bash -l -c "$PODS_TARGET_SRCROOT/../scripts/get-app-config-ios.sh"',
          'bash -l "$PODS_TARGET_SRCROOT/../scripts/get-app-config-ios.sh"'
        ).gsub(
          '/bin/sh -c "$WITH_ENVIRONMENT $SCRIPT_PHASES_SCRIPT"',
          '"$WITH_ENVIRONMENT" "$SCRIPT_PHASES_SCRIPT"'
        ).gsub(
          '. ${REACT_NATIVE_PATH}/sdks/hermes-engine/utils/build-hermesc-xcode.sh ${PODS_ROOT}/hermes-engine/build_host_hermesc ${REACT_NATIVE_PATH}/ReactCommon/jsi',
          '. "${REACT_NATIVE_PATH}/sdks/hermes-engine/utils/build-hermesc-xcode.sh" "${PODS_ROOT}/hermes-engine/build_host_hermesc" "${REACT_NATIVE_PATH}/ReactCommon/jsi"'
        ).gsub(
          '. ${REACT_NATIVE_PATH}/sdks/hermes-engine/utils/build-hermes-xcode.sh 0.76.9 ${PODS_ROOT}/hermes-engine/build_host_hermesc/ImportHermesc.cmake ${REACT_NATIVE_PATH}/ReactCommon/jsi',
          '. "${REACT_NATIVE_PATH}/sdks/hermes-engine/utils/build-hermes-xcode.sh" 0.76.9 "${PODS_ROOT}/hermes-engine/build_host_hermesc/ImportHermesc.cmake" "${REACT_NATIVE_PATH}/ReactCommon/jsi"'
        )
      end
    end

    installer.aggregate_targets.map(&:user_project).compact.uniq.each do |user_project|
      user_project.targets.each do |user_target|
        user_target.build_phases.each do |phase|
          next unless phase.respond_to?(:shell_script) && phase.shell_script
          next unless phase.shell_script.include?('/scripts/react-native-xcode.sh')

          phase.shell_script = phase.shell_script.gsub(
            '\\n"$RN_XCODE_SCRIPT"',
            "\n\"$RN_XCODE_SCRIPT\""
          ).sub(
            '`"$NODE_BINARY" --print "require(\'path\').dirname(require.resolve(\'react-native/package.json\')) + \'/scripts/react-native-xcode.sh\'"`',
            "RN_XCODE_SCRIPT=\"$(\"$NODE_BINARY\" --print \"require('path').dirname(require.resolve('react-native/package.json')) + '/scripts/react-native-xcode.sh'\")\"\n\"$RN_XCODE_SCRIPT\""
          )
        end

        next unless user_target.name == 'Darin'

        hermes_dsym_phase = user_target.shell_script_build_phases.find do |phase|
          phase.name == 'Copy Hermes dSYM'
        end
        hermes_dsym_phase ||= user_target.new_shell_script_build_phase('Copy Hermes dSYM')
        hermes_dsym_phase.shell_path = '/bin/sh'
        hermes_dsym_phase.input_paths = [
          '${PODS_ROOT}/hermes-engine/build/${PLATFORM_NAME}/API/hermes/hermes.framework.dSYM'
        ]
        hermes_dsym_phase.output_paths = [
          '${DWARF_DSYM_FOLDER_PATH}/hermes.framework.dSYM'
        ]
        hermes_dsym_phase.shell_script = <<~'SCRIPT'
          set -e
          HERMES_DSYM="${PODS_ROOT}/hermes-engine/build/${PLATFORM_NAME}/API/hermes/hermes.framework.dSYM"
          if [ "${ACTION}" = "install" ] && [ -d "${HERMES_DSYM}" ]; then
            mkdir -p "${DWARF_DSYM_FOLDER_PATH}"
            /usr/bin/ditto "${HERMES_DSYM}" "${DWARF_DSYM_FOLDER_PATH}/hermes.framework.dSYM"
          fi
        SCRIPT
      end
      user_project.save
    end

    # Ensure Release builds emit dSYM for the app and all pods (needed for
    # symbolication / TestFlight). Hermes is built from the RN-pinned source so
    # its archive dSYM UUID matches the embedded framework.
    installer.pods_project.targets.each do |pod_target|
      pod_target.build_configurations.each do |config|
        if config.name == 'Release'
          config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
        else
          config.build_settings['DEBUG_INFORMATION_FORMAT'] ||= 'dwarf'
        end
      end
    end

    # This is necessary for Xcode 14, because it signs resource bundles by default
    # when building for devices.
    installer.target_installation_results.pod_target_installation_results
      .each do |pod_name, target_installation_result|
      target_installation_result.resource_bundle_targets.each do |resource_bundle_target|
        resource_bundle_target.build_configurations.each do |config|
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        end
      end
    end
  end
end
