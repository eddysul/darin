{
  "expo": {
    "name": "Darin",
    "slug": "darin-childcare",
    "scheme": "knanny",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/darin-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.darin.childcare",
      "buildNumber": "21",
      "usesAppleSignIn": true,
      "splash": {
        "image": "./assets/darin-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF",
        "dark": {
          "image": "./assets/darin-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "splash": {
        "image": "./assets/darin-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF",
        "dark": {
          "image": "./assets/darin-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.darin.childcare",
      "versionCode": 21
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-system-ui",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo and video access is needed to add baby photos, diary images, and Our Moments media."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Darin to record voice notes for daily care logs."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/darin-logo.png",
          "color": "#E6B24A"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "c4f6a813-69fe-4591-8fd5-c6ba8a4d4c56"
      }
    },
    "owner": "darins-team"
  }
}
