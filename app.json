{
  "expo": {
    "name": "Darin",
    "slug": "darin-childcare",
    "scheme": "knanny",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/darin-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/darin-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.darin.childcare",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/darin-logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.darin.childcare"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "아기 사진과 일기·성장책 이미지를 추가하려면 사진 접근이 필요합니다."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Darin to record voice notes for daily care logs."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/darin-logo.png",
          "color": "#E8918A"
        }
      ]
    ]
  }
}
