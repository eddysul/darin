# dh / FastAPI server (local)
OPENAI_API_KEY=your_openai_api_key

# Expo client
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key
EXPO_PUBLIC_TRANSCRIBE_URL=http://127.0.0.1:8000

# Supabase — Expo client only (never put secret / service-role keys here)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Social login dev preview — 미구현 Apple/Google 버튼을 dev 모드에서만 표시
# (실제 활성화는 EXPO_PUBLIC_ENABLE_*_LOGIN=true + 코드 구현 필요)
EXPO_PUBLIC_SHOW_APPLE_LOGIN=true
EXPO_PUBLIC_SHOW_GOOGLE_LOGIN=true

# Server / Edge Function only (do NOT prefix with EXPO_PUBLIC_)
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWKS_URL=
