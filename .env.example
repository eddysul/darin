# Expo client
EXPO_PUBLIC_TRANSCRIBE_URL=https://darin-ai-1021237169934.us-west2.run.app

# Supabase — Expo client only (never put secret / service-role keys here)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Social login visibility and provider flags
EXPO_PUBLIC_SHOW_APPLE_LOGIN=true
EXPO_PUBLIC_SHOW_GOOGLE_LOGIN=true
EXPO_PUBLIC_ENABLE_APPLE_LOGIN=true
EXPO_PUBLIC_ENABLE_GOOGLE_LOGIN=true

# Server / Edge Function only (do NOT prefix with EXPO_PUBLIC_)
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWKS_URL=
